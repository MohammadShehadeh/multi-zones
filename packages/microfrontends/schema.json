{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "applications": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "default": {
            "description": "The app that owns the public domain and proxies every zone. Exactly one.",
            "type": "boolean"
          },
          "assetPrefix": {
            "description": "Path segment for this zone's _next assets and public files, e.g. \"docs-static\". Required with \"routing\".",
            "type": "string"
          },
          "routing": {
            "description": "Paths the default app forwards to this zone. Omit for a standalone app served on its own host.",
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": {
                  "description": "Label for readers, e.g. \"pages\" or \"api\".",
                  "type": "string"
                },
                "paths": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "source": {
                            "type": "string"
                          },
                          "destination": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "source",
                          "destination"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "description": "Next.js rewrite source syntax. A string is forwarded as-is; { source, destination } rewrites the path."
                }
              },
              "required": [
                "paths"
              ],
              "additionalProperties": false
            }
          },
          "development": {
            "type": "object",
            "properties": {
              "local": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Local dev/start port."
              },
              "host": {
                "description": "Local hostname, e.g. \"dashboard.localhost\". Defaults to \"localhost\".",
                "type": "string"
              }
            },
            "required": [
              "local"
            ],
            "additionalProperties": false
          },
          "production": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "url"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "development",
          "production"
        ],
        "additionalProperties": false
      },
      "description": "Keyed by each app's package.json name."
    }
  },
  "required": [
    "applications"
  ],
  "additionalProperties": false
}
