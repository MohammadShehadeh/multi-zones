{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "zones.json",
	"type": "object",
	"required": ["applications"],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"applications": {
			"type": "object",
			"description": "Keyed by each app's package.json name.",
			"additionalProperties": {
				"type": "object",
				"required": ["development", "production"],
				"additionalProperties": false,
				"properties": {
					"default": {
						"type": "boolean",
						"description": "The app that owns the public domain and proxies every other zone. Exactly one."
					},
					"assetPrefix": {
						"type": "string",
						"description": "Path segment for this zone's _next assets. Defaults to \"<name>-static\"."
					},
					"routing": {
						"type": "array",
						"description": "Paths the default app forwards to this zone (Next.js rewrite source syntax). Omit for a standalone app served on its own host.",
						"items": {
							"type": "object",
							"required": ["paths"],
							"properties": {
								"group": {
									"type": "string"
								},
								"paths": {
									"type": "array",
									"items": {
										"oneOf": [
											{
												"type": "string"
											},
											{
												"type": "object",
												"required": ["source", "destination"],
												"properties": {
													"source": {
														"type": "string"
													},
													"destination": {
														"type": "string"
													}
												}
											}
										]
									}
								}
							}
						}
					},
					"development": {
						"type": "object",
						"required": ["local"],
						"properties": {
							"local": {
								"type": "integer",
								"description": "Local dev/start port."
							},
							"host": {
								"type": "string",
								"description": "Local hostname, e.g. \"dashboard.localhost\". Defaults to \"localhost\"."
							}
						}
					},
					"production": {
						"type": "object",
						"required": ["url"],
						"properties": {
							"url": {
								"type": "string",
								"format": "uri"
							}
						}
					}
				}
			}
		}
	}
}
